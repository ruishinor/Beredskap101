{
  "name": "beredskap101",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-runtime.mjs",
    "dev:ui": "vite --port=3011 --host=0.0.0.0",
    "dev:api": "node --import tsx server.js",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173",
    "test:offline:smoke": "npm run build && playwright test tests/offline-smoke.spec.ts --project=chromium-offline",
    "verify:offline:smoke": "playwright test tests/offline-smoke.spec.ts --project=chromium-offline",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "ingest:preview": "tsx scripts/parse-assets.ts preview",
    "ingest:build": "tsx scripts/parse-assets.ts build",
    "ingest:validate": "tsx scripts/validate-processed-assets.ts",
    "verify:portability": "node scripts/verify-lockfile-portability.mjs",
    "verify:text-integrity": "node scripts/verify-text-integrity.mjs",
    "verify:localization": "node --import tsx scripts/verify-localization.mjs",
    "verify:module1:api": "node --import tsx scripts/verify-module1-api.mjs",
    "verify:module1": "node scripts/run-module1-verification.mjs",
    "verify:module2:contracts": "node scripts/verify-module2-contracts.mjs",
    "verify:module2": "node scripts/run-module2-verification.mjs",
    "verify:module3:contracts": "node --import tsx scripts/verify-module3-contracts.mjs",
    "verify:module3": "node scripts/run-module3-verification.mjs",
    "verify:module4:contracts": "node --import tsx scripts/verify-module4-contracts.mjs",
    "verify:module4": "node scripts/run-module4-verification.mjs",
    "verify:module5:contracts": "node --import tsx scripts/verify-module5-contracts.mjs",
    "verify:module5": "node scripts/run-module5-verification.mjs",
    "verify:module6:contracts": "node --import tsx scripts/verify-module6-contracts.mjs",
    "verify:module6": "node scripts/run-module6-verification.mjs",
    "verify:module7:contracts": "node scripts/verify-module7-contracts.mjs",
    "verify:module7": "node scripts/run-module7-verification.mjs",
    "test:e2e": "playwright test --project=chromium-offline",
    "verify:contracts": "npm run verify:module2:contracts && npm run verify:module3:contracts && npm run verify:module4:contracts && npm run verify:module5:contracts && npm run verify:module6:contracts && npm run verify:module7:contracts",
    "verify": "node scripts/run-verification.mjs",
    "verify:security": "npm audit --audit-level=moderate",
    "verify:release": "node scripts/run-verification.mjs --release",
    "ingest:report": "tsx scripts/validate-processed-assets.ts --write-report"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.8.0",
    "html5-qrcode": "^2.3.8",
    "i18next": "^26.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^5.24.0",
    "minisearch": "^7.2.0",
    "pmtiles": "^4.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
