# Browser application origin(s), comma-separated when several local origins are used.
APP_URL=http://localhost:3011

# Optional manual content-ingestion inputs.
B101_ASSETS_DIR=
B101_SOURCE_REVISION=

# External feed timeout, clamped by the application to 500-15000 ms.
B101_FEED_TIMEOUT_MS=15000

# Optional local OpenAI-compatible model used only by the local Node API.
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=qwen2.5:3b
